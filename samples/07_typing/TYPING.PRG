' ================================
' タイピングゲーム (TYPING)
' プチコン4用サンプルプログラム
' ================================
' 操作方法:
'   文字キー: タイピング
'   Aボタン: ゲーム開始/リスタート
' ================================

OPTION STRICT
ACLS

' 単語データ
DIM WORDS$[30]
DATA "HELLO", "WORLD", "BASIC", "PRINT", "INPUT"
DATA "LOOP", "NEXT", "GOTO", "SPRITE", "SOUND"
DATA "COLOR", "DRAW", "POINT", "PIXEL", "BEEP"
DATA "GAME", "PLAY", "START", "SCORE", "LEVEL"
DATA "SWITCH", "BUTTON", "TOUCH", "SCREEN", "LOAD"
DATA "SAVE", "DATA", "ARRAY", "STRING", "NUMBER"

' 変数宣言
DIM CURRENT_WORD$, TYPED$
DIM SCORE, COMBO, TIME_LEFT
DIM CORRECT, TOTAL
DIM GAME_ACTIVE, GAME_OVER
DIM FRAME_COUNT

' 初期化
GOSUB @LOAD_WORDS
GOSUB @GAME_INIT

' メインループ
LOOP
  VSYNC
  IF NOT GAME_ACTIVE AND NOT GAME_OVER THEN
    GOSUB @DRAW_TITLE
    IF BUTTON(2) AND 16 THEN GOSUB @START_GAME
  ELSEIF GAME_ACTIVE THEN
    GOSUB @INPUT
    GOSUB @UPDATE
    GOSUB @DRAW
  ELSE
    GOSUB @DRAW_RESULT
    IF BUTTON(2) AND 16 THEN GOSUB @GAME_INIT
  ENDIF
ENDLOOP

' ===== 単語読み込み =====
@LOAD_WORDS
RESTORE
FOR I = 0 TO 29
  READ WORDS$[I]
NEXT
RETURN

' ===== ゲーム初期化 =====
@GAME_INIT
ACLS
SCORE = 0
COMBO = 0
CORRECT = 0
TOTAL = 0
GAME_ACTIVE = FALSE
GAME_OVER = FALSE
RETURN

' ===== ゲーム開始 =====
@START_GAME
TIME_LEFT = 30 * 60  ' 30秒（60fps）
FRAME_COUNT = 0
GAME_ACTIVE = TRUE
GOSUB @NEW_WORD
RETURN

' ===== 新しい単語 =====
@NEW_WORD
CURRENT_WORD$ = WORDS$[RND(30)]
TYPED$ = ""
RETURN

' ===== 入力処理 =====
@INPUT
VAR K$ = INKEY$()
IF K$ != "" THEN
  ' アルファベットのみ受け付け
  VAR C = ASC(K$)
  IF C >= 65 AND C <= 90 THEN  ' A-Z
    TYPED$ = TYPED$ + K$
    GOSUB @CHECK_INPUT
  ELSEIF C >= 97 AND C <= 122 THEN  ' a-z (小文字を大文字に)
    TYPED$ = TYPED$ + CHR$(C - 32)
    GOSUB @CHECK_INPUT
  ENDIF
ENDIF
RETURN

' ===== 入力チェック =====
@CHECK_INPUT
' 正しい入力かチェック
IF TYPED$ == LEFT$(CURRENT_WORD$, LEN(TYPED$)) THEN
  ' 正しい
  IF TYPED$ == CURRENT_WORD$ THEN
    ' 単語完成
    CORRECT = CORRECT + 1
    COMBO = COMBO + 1
    SCORE = SCORE + LEN(CURRENT_WORD$) * 10 * (1 + COMBO / 5)
    BEEP 2
    GOSUB @NEW_WORD
  ELSE
    BEEP 0
  ENDIF
ELSE
  ' ミスタイプ
  TYPED$ = ""
  COMBO = 0
  BEEP 3
ENDIF
TOTAL = TOTAL + 1
RETURN

' ===== 更新処理 =====
@UPDATE
INC FRAME_COUNT
DEC TIME_LEFT
IF TIME_LEFT <= 0 THEN
  GAME_ACTIVE = FALSE
  GAME_OVER = TRUE
ENDIF
RETURN

' ===== タイトル描画 =====
@DRAW_TITLE
GFILL 0, 0, 319, 239, #001122

GFILL 60, 50, 260, 100, #112244
GBOX 60, 50, 260, 100, #00FFFF
LOCATE 10, 8 : COLOR #00FFFF : PRINT "タイピングゲーム"
COLOR #FFFFFF

LOCATE 8, 13 : PRINT "表示された単語をタイプせよ！"
LOCATE 12, 15 : PRINT "制限時間: 30秒"

GFILL 100, 170, 220, 200, #00AA00
GBOX 100, 170, 220, 200, #00FF00
LOCATE 12, 22 : PRINT "A: ゲーム開始"
RETURN

' ===== ゲーム描画 =====
@DRAW
GFILL 0, 0, 319, 239, #001122

' 残り時間バー
VAR TIME_RATIO! = TIME_LEFT / (30.0 * 60.0)
GFILL 20, 10, 300, 25, #333333
GFILL 20, 10, 20 + 280 * TIME_RATIO!, 25, #00FF00
GBOX 20, 10, 300, 25, #FFFFFF

' 残り時間テキスト
VAR SEC = TIME_LEFT / 60
LOCATE 1, 0 : PRINT "TIME: "; SEC

' 単語表示エリア
GFILL 40, 80, 280, 130, #223355
GBOX 40, 80, 280, 130, #FFFF00

' 単語表示
LOCATE 20 - LEN(CURRENT_WORD$) / 2, 12 : COLOR #FFFF00 : PRINT CURRENT_WORD$

' 入力済み部分をハイライト
IF LEN(TYPED$) > 0 THEN
  VAR START_X = 20 - LEN(CURRENT_WORD$) / 2
  LOCATE START_X, 12 : COLOR #00FF00 : PRINT TYPED$
ENDIF
COLOR #FFFFFF

' 入力表示
GFILL 80, 150, 240, 180, #000000
GBOX 80, 150, 240, 180, #888888
LOCATE 20 - LEN(TYPED$) / 2, 19 : PRINT TYPED$; "_"

' スコア・コンボ
LOCATE 1, 27 : PRINT "SCORE: "; SCORE
LOCATE 20, 27 : PRINT "COMBO: "; COMBO
LOCATE 30, 27 : PRINT "x"; CORRECT

RETURN

' ===== 結果描画 =====
@DRAW_RESULT
GFILL 0, 0, 319, 239, #001122

GFILL 60, 40, 260, 180, #112244
GBOX 60, 40, 260, 180, #FFFF00

LOCATE 14, 5 : COLOR #FFFF00 : PRINT "結 果"
COLOR #FFFFFF

LOCATE 12, 8 : PRINT "スコア: "; SCORE
LOCATE 12, 10 : PRINT "正解数: "; CORRECT
LOCATE 12, 12 : PRINT "入力数: "; TOTAL

IF TOTAL > 0 THEN
  VAR ACCURACY! = CORRECT * 100.0 / TOTAL
  LOCATE 12, 14 : PRINT "正確率: "; FORMAT$("%.1f", ACCURACY!); "%"
ENDIF

' 評価
LOCATE 12, 17
IF SCORE >= 3000 THEN
  COLOR #FFFF00 : PRINT "評価: S - 神速！"
ELSEIF SCORE >= 2000 THEN
  COLOR #00FF00 : PRINT "評価: A - 素晴らしい！"
ELSEIF SCORE >= 1000 THEN
  COLOR #00FFFF : PRINT "評価: B - なかなか！"
ELSEIF SCORE >= 500 THEN
  COLOR #FFFFFF : PRINT "評価: C - まずまず"
ELSE
  COLOR #888888 : PRINT "評価: D - 練習あるのみ"
ENDIF
COLOR #FFFFFF

GFILL 100, 200, 220, 225, #00AA00
LOCATE 12, 25 : PRINT "A: もう一度"
RETURN
