' ================================
' インベーダーゲーム (INVADERS)
' プチコン4用サンプルプログラム
' ================================
' 操作方法:
'   左右キー: 移動
'   Aボタン: 発射/リスタート
' ================================

OPTION STRICT
ACLS

' 定数定義
CONST SW = 320
CONST SH = 240
CONST ENEMY_COLS = 8
CONST ENEMY_ROWS = 4
CONST MAX_BULLETS = 5
CONST MAX_EBULLETS = 10

' プレイヤー
DIM PX, PY

' 敵
DIM ENEMY_X[ENEMY_COLS, ENEMY_ROWS]
DIM ENEMY_Y[ENEMY_COLS, ENEMY_ROWS]
DIM ENEMY_ALIVE[ENEMY_COLS, ENEMY_ROWS]
DIM ENEMY_DX, ENEMY_MOVE_TIME, ENEMY_SPEED

' 弾
DIM BULLET_X[MAX_BULLETS], BULLET_Y[MAX_BULLETS], BULLET_ACTIVE[MAX_BULLETS]
DIM EBULLET_X[MAX_EBULLETS], EBULLET_Y[MAX_EBULLETS], EBULLET_ACTIVE[MAX_EBULLETS]

' ゲーム状態
DIM SCORE, LIVES, REMAIN
DIM GAME_OVER, STAGE

' 色
DIM ENEMY_COLORS[4]
ENEMY_COLORS[0] = #FF00FF
ENEMY_COLORS[1] = #00FFFF
ENEMY_COLORS[2] = #FFFF00
ENEMY_COLORS[3] = #00FF00

' 初期化
GOSUB @GAME_INIT

' メインループ
LOOP
  VSYNC
  IF GAME_OVER THEN
    GOSUB @DRAW_GAMEOVER
    IF BUTTON(2) AND 16 THEN GOSUB @GAME_INIT
  ELSE
    GOSUB @INPUT
    GOSUB @UPDATE
    GOSUB @DRAW
  ENDIF
ENDLOOP

' ===== ゲーム初期化 =====
@GAME_INIT
ACLS
SCORE = 0
LIVES = 3
STAGE = 1
GAME_OVER = FALSE
GOSUB @INIT_STAGE
RETURN

' ===== ステージ初期化 =====
@INIT_STAGE
PX = SW / 2
PY = SH - 30

ENEMY_DX = 1
ENEMY_MOVE_TIME = 0
ENEMY_SPEED = 30 - STAGE * 3
IF ENEMY_SPEED < 5 THEN ENEMY_SPEED = 5

REMAIN = 0

' 敵配置
FOR ROW = 0 TO ENEMY_ROWS - 1
  FOR COL = 0 TO ENEMY_COLS - 1
    ENEMY_X[COL, ROW] = 30 + COL * 32
    ENEMY_Y[COL, ROW] = 40 + ROW * 24
    ENEMY_ALIVE[COL, ROW] = TRUE
    INC REMAIN
  NEXT
NEXT

' 弾初期化
FOR I = 0 TO MAX_BULLETS - 1
  BULLET_ACTIVE[I] = FALSE
NEXT
FOR I = 0 TO MAX_EBULLETS - 1
  EBULLET_ACTIVE[I] = FALSE
NEXT
RETURN

' ===== 入力処理 =====
@INPUT
VAR B = BUTTON(0)

' 移動
IF B AND 4 THEN PX = PX - 4
IF B AND 8 THEN PX = PX + 4
IF PX < 16 THEN PX = 16
IF PX > SW - 16 THEN PX = SW - 16

' 発射
IF BUTTON(2) AND 16 THEN
  FOR I = 0 TO MAX_BULLETS - 1
    IF NOT BULLET_ACTIVE[I] THEN
      BULLET_ACTIVE[I] = TRUE
      BULLET_X[I] = PX
      BULLET_Y[I] = PY - 10
      BEEP 1
      BREAK
    ENDIF
  NEXT
ENDIF
RETURN

' ===== 更新処理 =====
@UPDATE
' 自弾移動
FOR I = 0 TO MAX_BULLETS - 1
  IF BULLET_ACTIVE[I] THEN
    BULLET_Y[I] = BULLET_Y[I] - 6
    IF BULLET_Y[I] < 0 THEN BULLET_ACTIVE[I] = FALSE
  ENDIF
NEXT

' 敵弾移動
FOR I = 0 TO MAX_EBULLETS - 1
  IF EBULLET_ACTIVE[I] THEN
    EBULLET_Y[I] = EBULLET_Y[I] + 4
    IF EBULLET_Y[I] > SH THEN EBULLET_ACTIVE[I] = FALSE
    
    ' プレイヤーとの当たり判定
    IF ABS(EBULLET_X[I] - PX) < 12 AND ABS(EBULLET_Y[I] - PY) < 10 THEN
      EBULLET_ACTIVE[I] = FALSE
      LIVES = LIVES - 1
      BEEP 3
      IF LIVES <= 0 THEN GAME_OVER = TRUE
    ENDIF
  ENDIF
NEXT

' 敵移動
INC ENEMY_MOVE_TIME
IF ENEMY_MOVE_TIME >= ENEMY_SPEED THEN
  ENEMY_MOVE_TIME = 0
  
  VAR NEED_DOWN = FALSE
  FOR ROW = 0 TO ENEMY_ROWS - 1
    FOR COL = 0 TO ENEMY_COLS - 1
      IF ENEMY_ALIVE[COL, ROW] THEN
        ENEMY_X[COL, ROW] = ENEMY_X[COL, ROW] + ENEMY_DX * 8
        IF ENEMY_X[COL, ROW] < 20 OR ENEMY_X[COL, ROW] > SW - 20 THEN
          NEED_DOWN = TRUE
        ENDIF
      ENDIF
    NEXT
  NEXT
  
  IF NEED_DOWN THEN
    ENEMY_DX = -ENEMY_DX
    FOR ROW = 0 TO ENEMY_ROWS - 1
      FOR COL = 0 TO ENEMY_COLS - 1
        IF ENEMY_ALIVE[COL, ROW] THEN
          ENEMY_Y[COL, ROW] = ENEMY_Y[COL, ROW] + 12
          ' プレイヤーラインまで到達
          IF ENEMY_Y[COL, ROW] >= PY - 10 THEN
            GAME_OVER = TRUE
          ENDIF
        ENDIF
      NEXT
    NEXT
  ENDIF
  
  ' 敵が弾を発射
  IF RND(100) < 20 + STAGE * 5 THEN
    FOR I = 0 TO MAX_EBULLETS - 1
      IF NOT EBULLET_ACTIVE[I] THEN
        ' ランダムな敵から発射
        VAR SHOOTER_COL = RND(ENEMY_COLS)
        VAR SHOOTER_ROW = RND(ENEMY_ROWS)
        IF ENEMY_ALIVE[SHOOTER_COL, SHOOTER_ROW] THEN
          EBULLET_ACTIVE[I] = TRUE
          EBULLET_X[I] = ENEMY_X[SHOOTER_COL, SHOOTER_ROW]
          EBULLET_Y[I] = ENEMY_Y[SHOOTER_COL, SHOOTER_ROW] + 10
          BREAK
        ENDIF
      ENDIF
    NEXT
  ENDIF
ENDIF

' 弾と敵の当たり判定
FOR I = 0 TO MAX_BULLETS - 1
  IF BULLET_ACTIVE[I] THEN
    FOR ROW = 0 TO ENEMY_ROWS - 1
      FOR COL = 0 TO ENEMY_COLS - 1
        IF ENEMY_ALIVE[COL, ROW] THEN
          IF ABS(BULLET_X[I] - ENEMY_X[COL, ROW]) < 12 THEN
            IF ABS(BULLET_Y[I] - ENEMY_Y[COL, ROW]) < 10 THEN
              ENEMY_ALIVE[COL, ROW] = FALSE
              BULLET_ACTIVE[I] = FALSE
              REMAIN = REMAIN - 1
              SCORE = SCORE + (ENEMY_ROWS - ROW) * 10
              BEEP 0
            ENDIF
          ENDIF
        ENDIF
      NEXT
    NEXT
  ENDIF
NEXT

' クリア判定
IF REMAIN == 0 THEN
  STAGE = STAGE + 1
  SCORE = SCORE + 500
  GOSUB @INIT_STAGE
ENDIF
RETURN

' ===== 描画 =====
@DRAW
' 背景クリア
GFILL 0, 0, SW - 1, SH - 1, #000011

' 敵描画
FOR ROW = 0 TO ENEMY_ROWS - 1
  FOR COL = 0 TO ENEMY_COLS - 1
    IF ENEMY_ALIVE[COL, ROW] THEN
      VAR EX = ENEMY_X[COL, ROW]
      VAR EY = ENEMY_Y[COL, ROW]
      GFILL EX - 10, EY - 8, EX + 10, EY + 8, ENEMY_COLORS[ROW]
      ' 目
      GFILL EX - 5, EY - 3, EX - 3, EY, #000000
      GFILL EX + 3, EY - 3, EX + 5, EY, #000000
    ENDIF
  NEXT
NEXT

' 自弾描画
FOR I = 0 TO MAX_BULLETS - 1
  IF BULLET_ACTIVE[I] THEN
    GFILL BULLET_X[I] - 2, BULLET_Y[I] - 6, BULLET_X[I] + 2, BULLET_Y[I], #FFFFFF
  ENDIF
NEXT

' 敵弾描画
FOR I = 0 TO MAX_EBULLETS - 1
  IF EBULLET_ACTIVE[I] THEN
    GFILL EBULLET_X[I] - 2, EBULLET_Y[I], EBULLET_X[I] + 2, EBULLET_Y[I] + 8, #FF4444
  ENDIF
NEXT

' プレイヤー描画
GTRI PX, PY - 12, PX - 12, PY + 8, PX + 12, PY + 8, #00FF00

' 情報表示
LOCATE 0, 0 : PRINT "SCORE:"; SCORE; " STAGE:"; STAGE; " LIVES:"; LIVES
RETURN

' ===== ゲームオーバー描画 =====
@DRAW_GAMEOVER
GFILL 80, 90, 240, 150, #000000
GBOX 80, 90, 240, 150, #FF00FF
LOCATE 13, 11 : PRINT "GAME OVER"
LOCATE 11, 13 : PRINT "SCORE: "; SCORE
LOCATE 9, 15 : PRINT "PRESS A TO RETRY"
RETURN
